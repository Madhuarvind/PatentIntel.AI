# Local: npm run dev starts the frontend and authentication together.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# PORT/HOST apply to the standalone API (npm run api), not npm run dev.
AUTH_DATA_DIR=.data/auth
AUTH_MAIL_DIR=.data/mail
DOCUMENT_DATA_DIR=.data/documents
# Turn on to test required email verification locally. Links go to AUTH_MAIL_DIR.
AUTH_REQUIRE_VERIFICATION=false
# Optional: use a PostgreSQL server instead of the local embedded database.
# DATABASE_URL=postgresql://user:password@localhost:5432/patentintel
# Production: NODE_ENV=production, HOST=0.0.0.0, HTTPS APP_ORIGIN,
# managed PostgreSQL with verified TLS in DATABASE_URL and Resend HTTPS email.
# Use Supabase's session-pooler URL if the host cannot reach its IPv6 direct endpoint.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_VALUE
# SUPABASE_STORAGE_BUCKET=patentintel-documents
# RESEND_API_KEY=SERVER_ONLY_VALUE
# MAIL_FROM=PatentIntel <no-reply@example.com>
